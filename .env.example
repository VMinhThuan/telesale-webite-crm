# ERP Backend URL: https://locnuoc365.xyz
VITE_API_BASE_URL=https://locnuoc365.xyz

# Timeout request (ms)
VITE_API_TIMEOUT=15000

# Chế độ chạy: 'api' (kết nối trực tiếp ERP)
VITE_DATA_MODE=api

# Cloudflare R2 Training Storage
VITE_R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
VITE_R2_BUCKET_NAME=telesale-training
VITE_R2_ACCOUNT_ID=your_cloudflare_account_id
VITE_R2_ACCESS_KEY_ID=your_r2_access_key_id
VITE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
